# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Required for live runs. Not needed for --offline or for the tests. ---
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=123456:ABC...

# --- Optional ---
SHEETS_WEBHOOK_URL=

TRANSCRIPTION_MODEL=whisper-1
EXTRACTION_MODEL=gpt-4o-mini
OUTPUT_CSV=data/referrals.csv

# Records below this confidence are routed to a supervisor before use.
REVIEW_THRESHOLD=0.6

# --- Cost model. Override to recompute the unit cost against current rates. ---
RATE_TRANSCRIPTION_USD_PER_MIN=0.006
RATE_LLM_USD_PER_M_INPUT=0.15
RATE_LLM_USD_PER_M_OUTPUT=0.60
RATE_USD_TO_KES=129.0
